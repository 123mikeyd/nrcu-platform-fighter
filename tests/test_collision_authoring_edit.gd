extends SceneTree
var failures := 0
func check(ok: bool, text: String) -> void:
	if not ok: failures += 1; printerr("FAIL: " + text)
func _init() -> void: call_deferred("run")
func run() -> void:
	var p = load("res://scripts/core/collision/character_collision_profile.gd").new()
	p.character_id = "fixture"; p.body_radius = 0.3; p.body_height = 2.0; p.body_center = Vector3(0,1,0)
	ResourceSaver.save(p, "user://collision_authoring_fixture.tres")
	var before := FileAccess.get_file_as_bytes("user://collision_authoring_fixture.tres")
	var lab = load("res://scenes/collision_authoring_lab.tscn").instantiate(); root.add_child(lab)
	lab.open_profile("user://collision_authoring_fixture.tres")
	check(lab.has_method("edit_body"), "body controls edit validated working copy")
	if lab.has_method("edit_body"):
		check(lab.edit_body("0.4", "2.2", "0", "1.1", "0"), "valid edit")
		check(lab.body_wire.get_meta("radius") == 0.4, "edit updates preview")
		check(not lab.edit_body("nan", "2", "0", "1", "0"), "invalid text rejected")
		check(not lab.edit_body("-1", "2", "0", "1", "0"), "negative rejected")
		check(lab.working.body_radius == 0.4, "invalid edit atomic")
		check(not lab.save_override("res://assets/bad.tres"), "source save forbidden")
		check(not lab.save_override("user://collision_authoring_fixture.tres"), "generated source forbidden even in user")
		check(not lab.save_override("res://data/collision/overrides/../../bad.tres"), "traversal forbidden")
		check(lab.save_override("user://collision_authoring_override.tres"), "separate save")
		check(lab.reload_override("user://collision_authoring_override.tres"), "reload")
		check(lab.working.body_radius == 0.4 and lab.working.manual_override, "override reload preserves edit")
		check(not lab.reset_to_generated(false), "reset requires confirmation")
		check(lab.reset_to_generated(true) and lab.working.body_radius == 0.3, "reset generated")
		check(before == FileAccess.get_file_as_bytes("user://collision_authoring_fixture.tres"), "generated bytes preserved")
		check(lab.find_child("SaveOverride",true,false) != null, "save reachable UI")
	lab.free()
	print("PASS collision authoring edit" if failures == 0 else "FAILED collision authoring edit")
	quit(1 if failures else 0)
